{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOTEx",
  "version": "0.4.1",
  "identifier": "com.rkxp.notex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "NOTEx",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RKXP Software",
    "shortDescription": "Bloco de notas leve com abas, cadernos e sincronização",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["PortugueseBR"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
